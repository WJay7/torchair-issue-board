# Copy this file as .env in the same folder, then replace the example values.
# Do not commit the real .env file: it contains an access token.
GITCODE_BASE_URL=https://api.gitcode.com/api/v5
GITCODE_TOKEN=replace_with_your_personal_access_token
GITCODE_OWNER=Ascend
GITCODE_REPO=torchair

